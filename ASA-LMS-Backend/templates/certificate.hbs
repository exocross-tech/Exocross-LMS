<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Certificate of Completion</title>
</head>
<body style="font-family: Arial, sans-serif; text-align: center; padding: 40px; color: #333;">
  <div style="max-width: 800px; margin: 0 auto; border: 2px solid #2a6496; padding: 20px; position: relative;">
    <img src="{{logoImage}}" alt="Exocross LMS Logo" style="position: absolute; top: 20px; left: 20px; width: 80px;">
    <h1 style="font-size: 40px; font-family: 'Brush Script MT', cursive; color: #054a7a; margin-top: 20px; margin-bottom: 40px;">Certificate of Completion</h1>
    <div style="font-size: 18px; margin-bottom: 10px;">This certifies that</div>
    <div style="font-size: 36px; font-weight: bold; font-family: 'Comic Sans MS', cursive; margin: 20px 0;">{{participantName}}</div>
    <div style="font-size: 18px; margin-bottom: 10px;">Has completed</div>
    <div style="font-size: 28px; font-weight: bold; font-family: 'Comic Sans MS', cursive; margin: 20px 0;">{{courseName}}</div>
    <div style="font-size: 18px; margin: 30px 0;">We wish him/her all the best for the future!</div>
    <div style="font-size: 20px; color: #054a7a; margin-bottom: 60px;">Awarded on {{awardDate}}</div>
    <div style="margin: 0 40px 20px; font-size:26px; font-family:Marker Felt; ">
         {{#if facilitatorCount}}
            {{#if isSingleFacilitator}}
                <div style="text-align: center;">{{facilitators.[0].name}}</div>
            {{else}}
                <div style="display: flex; justify-content: space-between;">
                    {{#each facilitators}}
                        <div>{{this.name}}</div>
                    {{/each}}
                </div>
            {{/if}}
        {{/if}}
    </div>
    <div style="font-size: 24px; color: #054a7a; font-weight: bold; margin-top: 20px;">For Exocross LMS</div>
  </div>
</body>
</html>